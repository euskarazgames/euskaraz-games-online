{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "euskaraz-games-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/ws",
      "/mundu-jolastuak/original/*",
      "/mundu-jolastuak/games/*",
      "/klasiko",
      "/klasiko/*",
      "/health",
      "/ataria/api/*",
      "/garena/api/*",
      "/",
      "/index.html"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      },
      {
        "name": "ATARIA_STATS",
        "class_name": "AtariaStats"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AtariaStats"
      ]
    }
  ]
}
